{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodeLens",
  "version": "0.1.0",
  "identifier": "com.codelens.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CodeLens",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Code editor that shows the AI's reasoning in real time",
    "longDescription": "CodeLens is a lightweight desktop code editor where the integrated AI shows its reasoning token by token: which alternatives it considered, why it discarded them, and which parts of your code it used as context.",
    "copyright": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}